APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# FPV Trainer — frontend / Sanctum
# ------------------------------------------------------------------
# The Angular app runs on a separate origin (localhost:4200) and calls the
# API with a Sanctum Bearer token (Authorization header). Cookie/stateful
# auth is not used by default, so SANCTUM_STATEFUL_DOMAINS only matters if
# you opt into the alternative first-party-cookie SPA flow.
FRONTEND_URL=http://localhost:4200
FPV_CORS_ALLOWED_ORIGINS=http://localhost:4200
SANCTUM_STATEFUL_DOMAINS=localhost:4200

# ------------------------------------------------------------------
# FPV Trainer — catalog & versioning
# ------------------------------------------------------------------
FPV_CATALOG_PATH=
FPV_CATALOG_VERSION=1
FPV_PHYSICS_VERSION=1.1.0
FPV_SUPPORTED_PHYSICS_VERSIONS=1.0.0,1.1.0
FPV_REPLAY_VERSION=3
FPV_CLIENT_BUILD_VERSION=0.8.0
FPV_COLLISION_MODEL_VERSION=1.0.0
FPV_COLLIDER_MANIFEST_VERSION=1.0.0
FPV_ENVIRONMENT_ART_VERSION=1.0.0
FPV_DRONE_COLLIDER_VERSION=1.0.0
FPV_PHYSICS_ENGINE_VERSION=rapier-0.14.0
FPV_REPLAY_VERSION=2
FPV_SUBMISSION_VERSION=1
FPV_LEADERBOARD_RULES_VERSION=1
FPV_CLIENT_BUILD_VERSION=0.5.0

# ------------------------------------------------------------------
# FPV Trainer — limits & anti-cheat thresholds
# ------------------------------------------------------------------
FPV_RACE_SESSION_TTL_MINUTES=15
FPV_MAX_SPLITS_PER_RUN=64
FPV_MAX_REPLAY_FRAMES=20000
FPV_MAX_REPLAY_BYTES=2097152
FPV_MAX_EVENTS_PER_RUN=512

FPV_ANTICHEAT_MAX_SPEED_MPS=60
FPV_ANTICHEAT_MAX_TELEPORT_M=25
FPV_ANTICHEAT_MAX_ALTITUDE_M=500
FPV_ANTICHEAT_MIN_ALTITUDE_M=-50
FPV_ANTICHEAT_MANUAL_REVIEW_THRESHOLD=40
FPV_ANTICHEAT_REJECT_THRESHOLD=80

FPV_RATE_LIMIT_AUTH=10
FPV_RATE_LIMIT_SUBMISSIONS=30
FPV_RATE_LIMIT_API=120

FPV_CHALLENGE_ROTATION_PATH=
